{
    "name": "cwp/cwp",
    "description": "CWP features module. We strongly recommend using it for all new sites. Future features will be delivered here.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "cwp"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "cwp/cwp-core": "dev-upgrade/cms-6",
        "silverstripe/cms": "^6",
        "silverstripe/taxonomy": "^4",
        "symbiote/silverstripe-gridfieldextensions": "^5",
        "silverstripe/htmleditor-tinymce": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "squizlabs/php_codesniffer": "^3"
    },
    "conflict": {
        "silverstripe/auditor": "<2.2.1"
    },
    "suggest": {
        "silverstripe/crontask": "Allows CWP cleanup tasks to be scheduled"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/silverstripeltd/cwp-core.git"
        }
    ],
    "extra": {
        "expose": [
            "css",
            "javascript",
            "images"
        ]
    },
    "autoload": {
        "psr-4": {
            "CWP\\CWP\\": "src/",
            "CWP\\CWP\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
